# ── App
APP_NAME=Diabetes Progression Predictor
APP_VERSION=1.0.0
ENVIRONMENT=development         # development | staging | production
DEBUG=false
LOG_LEVEL=INFO

# ── Model
MODEL_ARTIFACTS_DIR=./model_artifacts
MODEL_RELOAD_INTERVAL_SECONDS=3600

# ── Drift
DRIFT_PSI_THRESHOLD=0.2
DRIFT_WINDOW_SIZE=100

# ── Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ── Auth (set API_KEYS_ENABLED=true in production)
API_KEYS_ENABLED=false
# Generate key hash: python -c "import hashlib; print(hashlib.sha256(b'your-key').hexdigest())"
API_KEY_HASHES=

# ── Metrics
METRICS_ENABLED=true
